# Production URL — used for canonical URLs, sitemap.xml, robots.txt and schema.
NEXT_PUBLIC_SITE_URL=https://www.zenithplumbing.com

# Google Tag Manager container (defaults to GTM-N5SFJ9B5). Set to "off" to disable.
NEXT_PUBLIC_GTM_ID=GTM-N5SFJ9B5

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty — set GA4 up inside
# Tag Manager instead, or visits will be counted twice.
NEXT_PUBLIC_GA_ID=G-E97JKKRNT0

# Optional: Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Built-in admin (/admin) ─────────────────────────────────────────
# Password to log in at /admin. The admin is turned off while this is empty.
ADMIN_PASSWORD=Zeith1@
# Optional: long random string used to sign the login cookie (changing it logs everyone out).
ADMIN_SESSION_SECRET=
# On Vercel: connect a Blob store (Project → Storage → Blob) and this is set for you.
# Without it, uploads are saved to ./storage on the server's disk.
BLOB_READ_WRITE_TOKEN=
# Optional: folder for uploads/content when not using Blob (default ./storage).
ADMIN_STORAGE_DIR=
